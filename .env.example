DATABASE_URL="postgresql://postgres:password@localhost:5432/pulse?schema=public"
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Email Configuration (Optional - Defaults to Ethereal test preview or console logging in dev)
EMAIL_FROM="Pulse <noreply@pulse.local>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
APP_URL="http://localhost:3000"

# AI Progress Interpretation (Optional, provider-agnostic)
# If AI_ENDPOINT or AI_MODEL is empty, the deterministic heuristic interpreter is used.
# Non-secret values may alternatively live in ai.config.json (see ai.config.example.json);
# environment variables override the file. The API key belongs in the environment ONLY.
# Works with any OpenAI-compatible provider (OpenAI, Azure OpenAI, Ollama, vLLM, LiteLLM, ...).
AI_PROVIDER=""                # registered provider name; empty = "openai-compatible" wire format
AI_ENDPOINT=""                # full http(s) URL of the chat endpoint
AI_API_KEY=""                 # secret; may stay empty if the gateway needs no auth
AI_MODEL=""                   # model or deployment name
AI_API_VERSION=""             # optional; appended as a query parameter when non-empty
AI_API_VERSION_PARAM=""       # query parameter name for the version (default: api-version)
AI_AUTH_HEADER=""             # header carrying the key (default: Authorization)
AI_AUTH_SCHEME=""             # value prefix (default: Bearer); "none" sends the raw key without a scheme
AI_EXTRA_HEADERS=""           # JSON object, e.g. {"X-Header":"value"}
AI_PROVIDER_OPTIONS=""        # JSON object merged verbatim into the request body
AI_JSON_MODE=""               # "false" or "0" disables the JSON response-format hint
AI_TIMEOUT_MS=""              # request timeout in ms (1000-60000, default 8000)
AI_CONFIG_PATH=""             # optional path to the JSON config file (default: ./ai.config.json)

# Step 6.07: Project Memory / RAG semantic search embeddings (Optional)
# If either is empty, embedding generation and semantic search are skipped entirely
# (text-only search keeps working unchanged). Reuses AI_API_KEY/AI_AUTH_HEADER/AI_AUTH_SCHEME above.
AI_EMBEDDING_ENDPOINT=""       # full http(s) URL of the embeddings endpoint
AI_EMBEDDING_MODEL=""          # embedding model name; must return 1536-dimension vectors
AI_EMBEDDING_DIMENSIONS=""     # optional; sends `dimensions` (e.g. 1536) for MRL models whose native size differs

# Phase 6: shared HMAC secret between Next.js internal API and pulse-agent
# The default below is public and only valid in development: production builds
# (NODE_ENV=production) reject every agent request until a unique value is set.
INTERNAL_API_SECRET="pulse-internal-secret-key-change-in-prod"
