## 5. Sunucu Tarafı Prisma Entegrasyonu (`board/page.tsx`)

Sayfa bileşeni Next.js 15+ asenkron `searchParams` standardıyla güncellenmiştir:

```typescript
// src/app/(main)/projects/[projectId]/board/page.tsx
const rawSearchParams = (await searchParams) ?? {};
const filters = parseBoardFilters(rawSearchParams);

// Prisma Dinamik Filtre Koşulları:
const taskWhere: Prisma.TaskWhereInput = {};
if (filters.priorities.length > 0) {
  taskWhere.priority = { in: filters.priorities };
}
if (filters.labelIds.length > 0) {
  taskWhere.labels = { some: { labelId: { in: filters.labelIds } } };
}
if (filters.assigneeIds.length > 0) {
  taskWhere.assignees = { some: { userId: { in: filters.assigneeIds } } };
}

// Prisma Dinamik Sıralama:
const taskOrderBy: Prisma.TaskOrderByWithRelationInput = filters.sort
  ? { [filters.sort]: filters.order }
  : { sortOrder: "asc" };
```

Bu yapı sayesinde veritabanı sunucusu istemciye yalnızca eşleşen kayıtları gönderir; tarayıcıda yüzlerce kartı filtrelemekle bellek harcanmaz.

