// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StateGroup {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SprintStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum RelationType {
  BLOCKS
  RELATES_TO
  DUPLICATES
}

enum NotificationType {
  TASK_ASSIGNED
  COMMENT_ADDED
  SPRINT_COMPLETED
  TASK_MENTIONED
  DUE_DATE_APPROACHING
  TASK_UNBLOCKED
  PROGRESS_REQUESTED
}

enum ActivityType {
  TASK_CREATED
  TASK_TITLE_UPDATED
  TASK_DESCRIPTION_UPDATED
  TASK_STATE_CHANGED
  TASK_PRIORITY_CHANGED
  TASK_DUE_DATE_CHANGED
  TASK_START_DATE_CHANGED
  TASK_ASSIGNEE_ADDED
  TASK_ASSIGNEE_REMOVED
  TASK_LABEL_ADDED
  TASK_LABEL_REMOVED
  TASK_SPRINT_ADDED
  TASK_SPRINT_REMOVED
  COMMENT_ADDED
  COMMENT_DELETED
  TASK_RELATION_ADDED
  TASK_RELATION_REMOVED
  TASK_COMPLETED
  TASK_UNBLOCKED
  PROGRESS_REQUESTED
  PROGRESS_RESPONDED
  AI_SUGGESTION_APPLIED
  AI_SUGGESTION_REJECTED
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  hashedPassword String
  image          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownedProjects   Project[]
  projectMembers  ProjectMember[]
  assignedTasks   TaskAssignee[]
  comments        Comment[]
  activities      Activity[]
  invitesSent     ProjectInvite[]
  notifications          Notification[] @relation("UserNotifications")
  triggeredNotifications Notification[] @relation("ActorNotifications")
  notificationPreferences UserNotificationPreference?

  receivedProgressRequests  ProgressRequest[]  @relation("ReceivedProgressRequests")
  requestedProgressRequests ProgressRequest[]  @relation("RequestedProgressRequests")
  progressResponses         ProgressResponse[]

  reviewedProposals AgentProposal[] @relation("ReviewedProposals")

  pmAgentSettings AgentSettings[]
}

model Project {
  id          String   @id @default(cuid())
  name        String
  identifier  String   @unique @db.VarChar(5)
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members ProjectMember[]
  states  State[]
  tasks   Task[]
  labels  Label[]
  sprints Sprint[]
  invites ProjectInvite[]

  progressRequests ProgressRequest[]
  agentProposals   AgentProposal[]

  agentRuns     AgentRun[]
  agentSettings AgentSettings[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model State {
  id        String     @id @default(cuid())
  name      String
  color     String     @default("#60646C")
  group     StateGroup
  sequence  Float      @default(65535)
  isDefault Boolean    @default(false)
  projectId String
  createdAt DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  suggestedByProposals AgentProposal[]

  @@unique([name, projectId])
  @@index([projectId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  priority    Priority  @default(NONE)
  sequenceId  Int
  sortOrder   Float     @default(65535)
  startDate   DateTime?
  dueDate     DateTime?
  projectId   String
  stateId     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  state     State          @relation(fields: [stateId], references: [id], onDelete: Restrict)
  labels     TaskLabel[]
  assignees  TaskAssignee[]
  comments   Comment[]
  sprints    SprintTask[]
  activities Activity[]

  sourceRelations TaskRelation[] @relation("SourceRelations")
  targetRelations TaskRelation[] @relation("TargetRelations")

  progressRequests ProgressRequest[]
  agentProposals   AgentProposal[]

  @@unique([projectId, sequenceId])
  @@index([projectId])
  @@index([stateId])
  @@index([projectId, stateId, sortOrder])
}

model TaskRelation {
  id           String       @id @default(cuid())
  sourceTaskId String
  targetTaskId String
  type         RelationType
  createdAt    DateTime     @default(now())

  sourceTask Task @relation("SourceRelations", fields: [sourceTaskId], references: [id], onDelete: Cascade)
  targetTask Task @relation("TargetRelations", fields: [targetTaskId], references: [id], onDelete: Cascade)

  @@unique([sourceTaskId, targetTaskId, type])
  @@index([sourceTaskId])
  @@index([targetTaskId])
}

model Label {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#60646C")
  projectId String
  createdAt DateTime @default(now())

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   TaskLabel[]

  @@unique([name, projectId])
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
}

model TaskAssignee {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  taskId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Sprint {
  id        String       @id @default(cuid())
  name      String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  status    SprintStatus @default(DRAFT)
  projectId String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   SprintTask[]

  @@index([projectId])
  @@index([projectId, status])
}

model SprintTask {
  sprintId String
  taskId   String
  addedAt  DateTime @default(now())

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([sprintId, taskId])
}

model Activity {
  id            String       @id @default(cuid())
  type          ActivityType
  taskId        String
  actorId       String
  oldValue      String?
  newValue      String?
  metadata      String?
  isAiGenerated Boolean      @default(false)
  createdAt     DateTime     @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, createdAt])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model ProjectInvite {
  id        String       @id @default(cuid())
  token     String       @unique
  email     String
  role      String       @default("MEMBER")
  status    InviteStatus @default(PENDING)
  projectId String
  inviterId String
  expiresAt DateTime
  createdAt DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviter User    @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([projectId])
  @@index([email])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?            @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([userId, createdAt])
}

model UserNotificationPreference {
  userId                   String   @id
  notifyTaskAssigned       Boolean  @default(true)
  notifyCommentAdded       Boolean  @default(true)
  notifyMentioned          Boolean  @default(true)
  notifyDueDateApproaching Boolean  @default(true)
  notifySprintClosed       Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


enum ProgressRequestStatus {
  PENDING
  RESPONDED
  EXPIRED
  CANCELLED
}

model ProgressRequest {
  id            String                @id @default(cuid())
  projectId     String
  taskId        String
  recipientId   String
  requestedById String?
  reason        String                @default("manual") // "manual" | "unblocked" | "scheduled"
  status        ProgressRequestStatus @default(PENDING)
  dueAt         DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  recipient   User               @relation("ReceivedProgressRequests", fields: [recipientId], references: [id], onDelete: Cascade)
  requestedBy User?              @relation("RequestedProgressRequests", fields: [requestedById], references: [id], onDelete: SetNull)
  responses   ProgressResponse[]

  @@index([taskId])
  @@index([recipientId, status])
  @@index([projectId])
}

model ProgressResponse {
  id                String   @id @default(cuid())
  progressRequestId String
  responderId       String
  content           String   @db.Text
  createdAt         DateTime @default(now())

  request   ProgressRequest @relation(fields: [progressRequestId], references: [id], onDelete: Cascade)
  responder User            @relation(fields: [responderId], references: [id], onDelete: Cascade)

  agentProposals AgentProposal[]

  @@index([progressRequestId])
  @@index([responderId])
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
  STALE
}

model AgentProposal {
  id                 String         @id @default(cuid())
  projectId          String
  taskId             String
  progressResponseId String?
  summary            String
  suggestedStateId   String?
  suggestedGroup     StateGroup?
  blockerDetected    Boolean        @default(false)
  blockerDetails     String?
  followUpNeeded     Boolean        @default(false)
  confidence         Float          @default(0.85)
  status             ProposalStatus @default(PENDING)
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime       @default(now())

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task             Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  progressResponse ProgressResponse? @relation(fields: [progressResponseId], references: [id], onDelete: SetNull)
  suggestedState   State?            @relation(fields: [suggestedStateId], references: [id], onDelete: SetNull)
  reviewedBy       User?             @relation("ReviewedProposals", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([taskId, status])
  @@index([projectId])
}

// ==========================================
// PHASE 6: AI AGENT COORDINATION MODELS
// ==========================================

model DomainEvent {
  id          String    @id @default(cuid())
  type        String // "TASK_CREATED", "TASK_STATE_CHANGED", "TASK_SPRINT_ADDED", "TASK_COMPLETED", vb.
  payload     Json // { taskId, projectId, oldValue, newValue, actorId, ... }
  status      String    @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  lockedAt    DateTime? // lease start set on claim; also the fencing token for finalize
  attempts    Int       @default(0) // incremented on every claim
  error       String? // last handler / lease-expiry error
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
  @@index([status, lockedAt])
}

model AgentRun {
  id           String    @id @default(cuid())
  agentKey     String // "agent-000", "agent-001", "agent-002", "agent-003", vb.
  projectId    String
  status       String    @default("RUNNING") // RUNNING | SUCCESS | FAILED | SKIPPED
  scheduledFor DateTime
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  result       Json? // { tasksProcessed: 5, notificationsSent: 2, ... }
  error        String?
  tokenCount   Int       @default(0)
  createdAt    DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([agentKey, projectId, scheduledFor])
  @@index([projectId])
  @@index([agentKey, status])
}

model AgentSettings {
  id        String   @id @default(cuid())
  projectId String
  agentKey  String // "agent-001", "agent-002", "agent-003", vb.
  enabled   Boolean  @default(true)
  config    Json     @default("{}")
  pmUserId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pmUser  User?   @relation(fields: [pmUserId], references: [id], onDelete: SetNull)

  @@unique([projectId, agentKey])
  @@index([projectId])
}

model SystemClock {
  id        String    @id @default("current")
  mockTime  DateTime?
  updatedAt DateTime  @updatedAt
}
