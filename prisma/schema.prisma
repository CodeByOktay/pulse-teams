// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StateGroup {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SprintStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum RelationType {
  BLOCKS
  RELATES_TO
  DUPLICATES
}

enum NotificationType {
  TASK_ASSIGNED
  COMMENT_ADDED
  SPRINT_COMPLETED
}

enum ActivityType {
  TASK_CREATED
  TASK_TITLE_UPDATED
  TASK_DESCRIPTION_UPDATED
  TASK_STATE_CHANGED
  TASK_PRIORITY_CHANGED
  TASK_DUE_DATE_CHANGED
  TASK_START_DATE_CHANGED
  TASK_ASSIGNEE_ADDED
  TASK_ASSIGNEE_REMOVED
  TASK_LABEL_ADDED
  TASK_LABEL_REMOVED
  TASK_SPRINT_ADDED
  TASK_SPRINT_REMOVED
  COMMENT_ADDED
  COMMENT_DELETED
  TASK_RELATION_ADDED
  TASK_RELATION_REMOVED
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  hashedPassword String
  image          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownedProjects   Project[]
  projectMembers  ProjectMember[]
  assignedTasks   TaskAssignee[]
  comments        Comment[]
  activities      Activity[]
  invitesSent     ProjectInvite[]
  notifications          Notification[] @relation("UserNotifications")
  triggeredNotifications Notification[] @relation("ActorNotifications")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  identifier  String   @unique @db.VarChar(5)
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members ProjectMember[]
  states  State[]
  tasks   Task[]
  labels  Label[]
  sprints Sprint[]
  invites ProjectInvite[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model State {
  id        String     @id @default(cuid())
  name      String
  color     String     @default("#60646C")
  group     StateGroup
  sequence  Float      @default(65535)
  isDefault Boolean    @default(false)
  projectId String
  createdAt DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([name, projectId])
  @@index([projectId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  priority    Priority  @default(NONE)
  sequenceId  Int
  sortOrder   Float     @default(65535)
  startDate   DateTime?
  dueDate     DateTime?
  projectId   String
  stateId     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  state     State          @relation(fields: [stateId], references: [id], onDelete: Restrict)
  labels     TaskLabel[]
  assignees  TaskAssignee[]
  comments   Comment[]
  sprints    SprintTask[]
  activities Activity[]

  sourceRelations TaskRelation[] @relation("SourceRelations")
  targetRelations TaskRelation[] @relation("TargetRelations")

  @@unique([projectId, sequenceId])
  @@index([projectId])
  @@index([stateId])
  @@index([projectId, stateId, sortOrder])
}

model TaskRelation {
  id           String       @id @default(cuid())
  sourceTaskId String
  targetTaskId String
  type         RelationType
  createdAt    DateTime     @default(now())

  sourceTask Task @relation("SourceRelations", fields: [sourceTaskId], references: [id], onDelete: Cascade)
  targetTask Task @relation("TargetRelations", fields: [targetTaskId], references: [id], onDelete: Cascade)

  @@unique([sourceTaskId, targetTaskId, type])
  @@index([sourceTaskId])
  @@index([targetTaskId])
}

model Label {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#60646C")
  projectId String
  createdAt DateTime @default(now())

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   TaskLabel[]

  @@unique([name, projectId])
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
}

model TaskAssignee {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  taskId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Sprint {
  id        String       @id @default(cuid())
  name      String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  status    SprintStatus @default(DRAFT)
  projectId String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   SprintTask[]

  @@index([projectId])
  @@index([projectId, status])
}

model SprintTask {
  sprintId String
  taskId   String
  addedAt  DateTime @default(now())

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([sprintId, taskId])
}

model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  taskId    String
  actorId   String
  oldValue  String?
  newValue  String?
  metadata  String?
  createdAt DateTime     @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, createdAt])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model ProjectInvite {
  id        String       @id @default(cuid())
  token     String       @unique
  email     String
  role      String       @default("MEMBER")
  status    InviteStatus @default(PENDING)
  projectId String
  inviterId String
  expiresAt DateTime
  createdAt DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviter User    @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([projectId])
  @@index([email])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?            @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([userId, createdAt])
}

