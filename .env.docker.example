# Environment for the `app` service in docker-compose.yml (production build).
# Copy to .env.docker and replace every placeholder before running `docker compose up -d`.

# Host "db" is the compose service name; the password must match POSTGRES_PASSWORD
# (default: "password", overridable from the repo root .env).
DATABASE_URL="postgresql://postgres:password@db:5432/pulse?schema=public"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Shared HMAC secret with the pulse-agent service. The agent reads it from the
# INTERNAL_API_SECRET variable in the repo root .env, so both values must match.
# The production build rejects all agent requests while this is the public default.
INTERNAL_API_SECRET="replace-with-a-random-secret"

# Optional: email and AI provider settings (see .env.example for the full list).
EMAIL_FROM="Pulse <noreply@pulse.local>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
AI_ENDPOINT=""
AI_API_KEY=""
AI_MODEL=""
